{
  "name": "kompakkt.repo",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:docker": "ng serve --host=0.0.0.0 --disable-host-check",
    "start:prod": "ng serve --configuration=production",
    "build": "ng build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun check",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "update:kompakkt:common": "bun run update-git-dependency.ts -d @kompakkt/common -o Kompakkt -r Common -b main",
    "update:kompakkt:komponents": "bun run update-git-dependency.ts -d @kompakkt/komponents -o Kompakkt -r Komponents -b main",
    "update:kompakkt:plugins": "bun run update-git-dependency.ts -d @kompakkt/plugins -o Kompakkt -r Plugins -b main",
    "update:kompakkt:server-openapi": "bun run update-git-dependency.ts -d @kompakkt/server-openapi -o Kompakkt -r Server -b openapi-types",
    "e2e": "concurrently \"ng serve --port 1503\" \"wait-on http-get://localhost:1503 && npm run cy:run\" --kill-others --success first",
    "e2e-gui": "concurrently \"ng serve --port 1503\" \"wait-on http-get://localhost:1503 && npm run cy:open\" --kill-others --success first",
    "extract-translations": "ts-node --skipProject ./extract-translations.ts"
  },
  "contributors": [
    {
      "name": "Jan G. Wieners",
      "email": "jan.wieners@uni-koeln.de",
      "url": "https://jan-wieners.de"
    },
    {
      "name": "Kai Niebes",
      "email": "kai.niebes@outlook.com",
      "url": "https://github.com/HeyItsBATMAN"
    },
    {
      "name": "Zoe Schubert"
    }
  ],
  "private": true,
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@kompakkt/common": "git+https://github.com/Kompakkt/Common.git#49b7d222f9d6edd719ae7183ba53c96acedd9d0f",
    "@kompakkt/komponents": "git+https://github.com/Kompakkt/Komponents.git#a8299aa77713b01270aa43d2a69a3a6ba26959e7",
    "@kompakkt/plugins": "git+https://github.com/Kompakkt/Plugins.git#0ff71dfc2f48041b5e8ea3d652f7c0101f2813ad",
    "@kompakkt/server-openapi": "git+https://github.com/Kompakkt/Server.git#d73de702a6b2a94c4824f95e5fef008ac18d572b",
    "bson-objectid": "^2.0.4",
    "fast-deep-equal": "^3.1.3",
    "fscreen": "1.2.0",
    "idb": "^8.0.3",
    "pluralize": "^8.0.0",
    "rfdc": "^1.4.1",
    "rxjs": "7.8.2",
    "spark-md5": "^3.0.2",
    "tslib": "^2.8.1",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@types/bun": "^1.4.3",
    "@types/fscreen": "1.0.4",
    "@types/node": "^25.5.0",
    "@types/pluralize": "^0.0.33",
    "@types/spark-md5": "^3.0.5",
    "concurrently": "^9.2.1",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.18.1",
    "ts-node": "~10.9.2",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "@kompakkt/komponents": {
      "@angular/core": "22.2.3"
    },
    "@kompakkt/plugins": {
      "@angular/core": "22.2.3",
      "@kompakkt/common": "git+https://github.com/Kompakkt/Common.git#49b7d222f9d6edd719ae7183ba53c96acedd9d0f"
    }
  },
  "trustedDependencies": [
    "@kompakkt/common",
    "@kompakkt/plugins"
  ]
}
